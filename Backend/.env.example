# ---- Database (required) -------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ---- Authentication (REQUIRED in production) -----------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If missing, the API derives a key from DATABASE_URL and logs a warning.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TTL_SECONDS=28800

# ---- CORS ----------------------------------------------------------------
# Exact frontend origin(s), comma-separated.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, e.g. https://masar-.*\.netlify\.app  (leave empty to disable)
FRONTEND_ORIGIN_REGEX=

# ---- Sign-up rules -------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=uaeu.ac.ae
# Direct sign-up skips e-mail verification. Keep false; only enable for local scripts.
ALLOW_DIRECT_SIGNUP=false

# ---- E-mail (OTP codes) --------------------------------------------------
# EMAIL_PROVIDER=resend | smtp.  Leave empty for development: codes are printed to the console.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
# The sender domain must be verified in Resend, otherwise Resend only delivers to your own account address.
RESEND_FROM=Masar <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true = print the code to the console when sending fails (development ONLY). Keep false in production.
EMAIL_DEV_CONSOLE=false

# ---- Optional AI explanation layer ---------------------------------------
# The rule engine always decides WHICH courses are recommended; AI only rewrites the "why" text.
AI_EXPLANATION_ENABLED=false
AI_API_KEY=
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Per-request timeout (min 5). Results are cached, so only the first load of a profile waits for the model.
AI_EXPLANATION_TIMEOUT_SECONDS=12
AI_EXPLANATION_MAX_RETRIES=2
AI_EXPLANATION_BUDGET_SECONDS=25

# ---- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
